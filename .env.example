# ==============================================================================
# AMIT TOUCH Studio Management System - Environment Variables Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Initial Owner Account Credentials (Optional)
# If provided, the server will seed the owner account on first launch.
# If omitted, the first-time setup wizard in the browser will configure the owner account.
OWNER_EMAIL=
OWNER_PASSWORD=

# Outgoing Email Configuration
# ------------------------------------------------------------------------------
# OPTION A: Gmail API via Google OAuth 2.0 (Recommended for Render Free - Direct from Owner Gmail)
# Uses standard HTTPS port 443 with gmail.send scope. Unrestricted on Render Free.
# Get credentials at Google Cloud Console (console.cloud.google.com):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# OPTION B: HTTPS REST API (Resend / Brevo)
# 1. Resend ($0.00/mo - 3,000 emails/month, 100/day):
EMAIL_PROVIDER=gmail
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME="AMIT TOUCH"
AUTO_BCC_EMAIL=amit2001tal@gmail.com

# 2. Brevo ($0.00/mo - 300 emails/day, single-sender email verification without DNS):
# BREVO_API_KEY=

# OPTION C: Gmail / Standard SMTP (Preserved for Local Development)
# Works on localhost without port blocks.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Headless Chrome / Chromium Path (Optional)
# Required on Linux/Docker if Chrome/Chromium is installed in a non-standard directory.
# Common Linux paths: /usr/bin/google-chrome-stable, /usr/bin/chromium, /usr/bin/chromium-browser
CHROME_BIN=
PUPPETEER_EXECUTABLE_PATH=

# Cryptographic PDF Signing (Section 18ב / Israeli Bookkeeping Directives)
# Place private keys and certificates in certs/ or specify custom paths below.
SIGNING_CERT_PATH=
SIGNING_KEY_PATH=
SIGNING_KEY_PASSPHRASE=
ELECTRONIC_RECEIPTS_ENABLED=true
