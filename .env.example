# ==============================================================================
# AMIT TOUCH Studio Management System - Environment Variables Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Initial Owner Account Credentials (Optional)
# If provided, the server will seed the owner account on first launch.
# If omitted, the first-time setup wizard in the browser will configure the owner account.
OWNER_EMAIL=
OWNER_PASSWORD=

# Outgoing Email SMTP Configuration (Optional)
# Can be configured via environment variables or in the application Settings.
# The server will never expose SMTP passwords to the browser or in backup files.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME="AMIT TOUCH"

# Headless Chrome / Chromium Path (Optional)
# Required on Linux/Docker if Chrome/Chromium is installed in a non-standard directory.
# Common Linux paths: /usr/bin/google-chrome-stable, /usr/bin/chromium, /usr/bin/chromium-browser
CHROME_BIN=
PUPPETEER_EXECUTABLE_PATH=

# Cryptographic PDF Signing (Section 18ב / Israeli Bookkeeping Directives)
# Place private keys and certificates in certs/ or specify custom paths below.
SIGNING_CERT_PATH=
SIGNING_KEY_PATH=
SIGNING_KEY_PASSPHRASE=
ELECTRONIC_RECEIPTS_ENABLED=true
